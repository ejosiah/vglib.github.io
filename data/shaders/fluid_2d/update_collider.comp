#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 32, local_size_y = 32) in;

#include "common.glsl"

const uint BOUNDARY_EDGE_LEFT = 1u << 0u;
const uint BOUNDARY_EDGE_RIGHT = 1u << 1u;
const uint BOUNDARY_EDGE_BOTTOM = 1u << 2u;
const uint BOUNDARY_EDGE_TOP = 1u << 3u;
const float BOUNDARY_TYPE_WALL_VALUE = 0.0;

layout(set = 1, binding = 2, rg32f) uniform writeonly image2D colliderOut;
layout(set = 2, binding = 2, rg32f) uniform writeonly image2D colliderVelocityOut;

layout(push_constant, scalar) uniform Constants {
    uint colliderCount;
    uint closedDomain;
    uint openBoundaryEdges;
};

bool isEdgeClosed(uint edge) {
    return (openBoundaryEdges & edge) == 0u;
}

bool onClosedDomainBoundary() {
    return (gid.x == 0 && isEdgeClosed(BOUNDARY_EDGE_LEFT)) ||
           (gid.x == grid_size.x - 1 && isEdgeClosed(BOUNDARY_EDGE_RIGHT)) ||
           (gid.y == 0 && isEdgeClosed(BOUNDARY_EDGE_BOTTOM)) ||
           (gid.y == grid_size.y - 1 && isEdgeClosed(BOUNDARY_EDGE_TOP));
}

void main() {
    if(outOfBounds()) return;

    vec2 uv = get_uv();
    vec2 collider = vec2(1.0, BOUNDARY_TYPE_WALL_VALUE);
    vec2 colliderVelocity = vec2(0.0);

    if(closedDomain != 0u && onClosedDomainBoundary()) {
        collider.x = -0.5 * length(vec2(dx.x, dy.y));
    }

    imageStore(colliderOut, gid, vec4(collider, 0.0, 0.0));
    imageStore(colliderVelocityOut, gid, vec4(colliderVelocity, 0.0, 0.0));
}
