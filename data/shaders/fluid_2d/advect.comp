#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_debug_printf : enable

layout(local_size_x = 32, local_size_y = 32) in;

#define COLLISION_SET 7
#include "common.glsl"

layout(set = 1, binding = 0) uniform sampler3D vector_field_u;
layout(set = 2, binding = 0) uniform sampler3D vector_field_v;
layout(set = 3, binding = 0) uniform sampler3D vector_field_w;
layout(set = 4, binding = 1) uniform texture3D quantity;
layout(set = 5, binding = 2) uniform writeonly image3D quantity_out;
layout(set = 6, binding = 0) uniform sampler aSampler;

layout(push_constant) uniform Constants {
    float time_sign;
    uint boundary_mode;
};

vec3 loadVectorField(vec3 centerUv, vec3 sampleUv) {
    vec3 uv = sampleUv;
    vec3 u;
    u.x = texture(vector_field_u, uv).x;
    u.y = texture(vector_field_v, uv).x;
    u.z = is3D ? texture(vector_field_w, uv).x : 0.0;

    return u;
}


vec4 getQuantity(vec3 xyz) {
    return texture(sampler3D(quantity, aSampler), xyz);
}

void updateQuantity(vec4 q) {
    imageStore(quantity_out, gid3, q);
}

vec4 sampleQuantity(vec3 centerUv, vec3 sampleUv) {
    if(outOfBoundsThroughOpenEdge(sampleUv)) {
        return vec4(0.0);
    }

    return getQuantity(sampleUv);
}

void main() {
    if(outOfBounds()) return;

    vec3 uv = get_uvw();
    if(sampleBoundary(uv) < 0.0) {
        updateQuantity(vec4(0.0));
        return;
    }

    vec4 q0 = sampleQuantity(uv, uv);
    vec3 u = loadVectorField(uv, uv);


    vec3 pm = uv - 0.5 * time_sign * dt * u;
    u = loadVectorField(uv, pm);

    vec3 p = uv - time_sign * dt * u;
    vec4 q1 = sampleQuantity(uv, p);

    // TODO: Use substepping here; endpoint SDF checks can miss thin colliders.
    float phi0 = sampleBoundary(uv);
    float phi1 = sampleBoundary(p);

    float w = (phi0 * phi1) < 0.0 ? abs(phi1) / max(abs(phi0) + abs(phi1), EPSILON) : 0.0;
//    debugPrintfEXT("ph0: %f, ph1 %f, w: %f\n", phi0, phi1, w);
    vec4 q = mix(q1, q0, w);

    updateQuantity(q);
}
