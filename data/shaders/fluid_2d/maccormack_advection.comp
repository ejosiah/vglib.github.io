#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 32, local_size_y = 32) in;

#define BOUNDARY_SET 7
#include "common.glsl"

layout(set = 1, binding = 0) uniform sampler2D vector_field_u;
layout(set = 2, binding = 0) uniform sampler2D vector_field_v;
layout(set = 3, binding = 0) uniform sampler2D ph1_n1_texture;
layout(set = 4, binding = 0) uniform sampler2D ph1_n_texture;
layout(set = 5, binding = 0) uniform sampler2D quantity;
layout(set = 6, binding = 2) uniform writeonly image2D quantity_out;

layout(push_constant) uniform Constants {
    float time_sign;
    uint boundary_mode;
};

vec2 loadVectorField(vec2 centerUv, vec2 sampleUv) {
    vec2 uv = scalarBoundarySampleUv(centerUv, sampleUv);
    vec2 u;
    u.x = texture(vector_field_u, uv).x;
    u.y = texture(vector_field_v, uv).x;

    return reflectVelocityAtBoundary(u, centerUv, sampleUv);
}

void updateQuantity(vec4 q) {
    imageStore(quantity_out, gid, q);
}

vec4 sampleField(sampler2D field, vec2 centerUv, vec2 sampleUv) {
    vec2 uv = scalarBoundarySampleUv(centerUv, sampleUv);
    vec4 q = texture(field, uv);
    q.x = reflectVelocityComponentAtBoundary(q.x, boundary_mode, centerUv, sampleUv);
    return q;
}

void main() {
    if(outOfBounds()) return;

    vec2 uv = get_uv();
    if(checkBoundary(uv)){
        updateQuantity(vec4(0));
        return;
    }

    vec2 u = loadVectorField(uv, uv);

    vec2 rawP = uv - dt * u;
    vec2 p = scalarBoundarySampleUv(uv, rawP);

    vec2 p0 = floor(p/(dx + dy) - 0.5) + 0.5;
    p0  = p0 * (dx + dy);
    vec2 p1 = p0 + dx;
    vec2 p2 = p0 + dy;
    vec2 p3 = p1 + dy;

    vec4 q0 = sampleField(quantity, uv, p0);
    vec4 q1 = sampleField(quantity, uv, p1);
    vec4 q2 = sampleField(quantity, uv, p2);
    vec4 q3 = sampleField(quantity, uv, p3);

    vec4 qMin = min(min(q0, q1), min(q2, q3));
    vec4 qMax = max(max(q0, q1), max(q2, q3));

    vec4 ph1_n1h = sampleField(ph1_n1_texture, uv, uv);
    vec4 ph1_nh = sampleField(ph1_n_texture, uv, rawP);
    vec4 ph1n = sampleField(quantity, uv, uv);

    vec4 q = (ph1_n1h + 0.5 * (ph1n - ph1_nh));
    q = clamp(q, qMin, qMax);
    q.x = reflectVelocityComponentAtBoundary(q.x, boundary_mode, uv, rawP);
    updateQuantity(q);
}
