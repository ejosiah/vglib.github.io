#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 32, local_size_y = 32) in;

#include "common.glsl"

const uint MAX_COLLIDERS = 10u;
const uint BOUNDARY_EDGE_LEFT = 1u << 0u;
const uint BOUNDARY_EDGE_RIGHT = 1u << 1u;
const uint BOUNDARY_EDGE_BOTTOM = 1u << 2u;
const uint BOUNDARY_EDGE_TOP = 1u << 3u;
const uint BOUNDARY_EDGE_BACK = 1u << 4u;
const uint BOUNDARY_EDGE_FRONT = 1u << 5u;
const float BOUNDARY_TYPE_WALL_VALUE = 0.0;

layout(set = 1, binding = 2, rg32f) uniform writeonly image3D colliderOut;
layout(set = 2, binding = 2, rg32f) uniform writeonly image3D colliderVelocityOut;
layout(set = 3, binding = 0) uniform sampler3D colliderFields[MAX_COLLIDERS];
layout(set = 3, binding = 1) uniform sampler3D colliderVelocityFields[MAX_COLLIDERS];

layout(push_constant, scalar) uniform Constants {
    uint colliderCount;
    uint closedDomain;
    uint openBoundaryEdges;
};

bool isEdgeClosed(uint edge) {
    return (openBoundaryEdges & edge) == 0u;
}

bool onClosedDomainBoundary() {
    return (gid.x == 0 && isEdgeClosed(BOUNDARY_EDGE_LEFT)) ||
           (gid.x == grid_size.x - 1 && isEdgeClosed(BOUNDARY_EDGE_RIGHT)) ||
           (gid.y == 0 && isEdgeClosed(BOUNDARY_EDGE_BOTTOM)) ||
           (gid.y == grid_size.y - 1 && isEdgeClosed(BOUNDARY_EDGE_TOP)) ||
           (is3D && gid3.z == 0 && isEdgeClosed(BOUNDARY_EDGE_BACK)) ||
           (is3D && gid3.z == grid_size.z - 1 && isEdgeClosed(BOUNDARY_EDGE_FRONT));
}

void main() {
    if(outOfBounds()) return;

    vec3 uv = get_uvw();
    vec2 collider = vec2(1.0, BOUNDARY_TYPE_WALL_VALUE);
    vec2 colliderVelocity = vec2(0.0);

    if(closedDomain != 0u && onClosedDomainBoundary()) {
        collider.x = -0.5 * length(vec3(dx.x, dy.y, is3D ? dz.z : 0.0));
    }

    uint count = min(colliderCount, MAX_COLLIDERS);
    for(uint i = 0u; i < count; ++i) {
        vec2 candidate = texture(colliderFields[i], uv).xy;
        if(candidate.x < collider.x) {
            collider = candidate;
            colliderVelocity = texture(colliderVelocityFields[i], uv).xy;
        }
    }

    imageStore(colliderOut, gid3, vec4(collider, 0.0, 0.0));
    imageStore(colliderVelocityOut, gid3, vec4(colliderVelocity, 0.0, 0.0));
}
