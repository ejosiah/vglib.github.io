#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8) in;

#define COLLISION_SET 8
#include "common.glsl"

layout(set = 1, binding = 0) uniform sampler3D vector_field_u_in;
layout(set = 2, binding = 0) uniform sampler3D vector_field_v_in;
layout(set = 3, binding = 0) uniform sampler3D vector_field_w_in;
layout(set = 4, binding = 0) uniform sampler3D force_field_in;

layout(set = 5, binding = 2) uniform writeonly image3D vector_field_u_out;
layout(set = 6, binding = 2) uniform writeonly image3D vector_field_v_out;
layout(set = 7, binding = 2) uniform writeonly image3D vector_field_w_out;

vec3 vector_field(vec3 uv) {
    vec3 u;
    u.x = texture(vector_field_u_in, uv).x;
    u.y = texture(vector_field_v_in, uv).x;
    u.z = is3D ? texture(vector_field_w_in, uv).x : 0.0;

    return u;
}

vec3 force_field(vec3 uv) {
    vec4 f = texture(force_field_in, uv);
    return vec3(f.xy, is3D ? f.z : 0.0);
}

void main() {
    if(outOfBounds()) return;

    vec3 xyz = get_uvw();

    vec3 u = vector_field(xyz) + force_field(xyz) * dt;

    imageStore(vector_field_u_out, gid3, vec4(u.x));
    imageStore(vector_field_v_out, gid3, vec4(u.y));
    imageStore(vector_field_w_out, gid3, vec4(u.z));
}
