#version 460

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform sampler3D sourceField;

layout(set = 1, binding = 0, scalar) writeonly buffer Target {
    float values[];
};

layout(push_constant, scalar) uniform Constants {
    float scale;
    uint count;
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    if(index >= count) return;

    ivec3 size = textureSize(sourceField, 0);
    uint cellsPerSlice = uint(size.x * size.y);
    ivec3 cell = ivec3(
        int(index % uint(size.x)),
        int((index % cellsPerSlice) / uint(size.x)),
        int(index / cellsPerSlice)
    );
    values[index] = scale * texelFetch(sourceField, cell, 0).x;
}
