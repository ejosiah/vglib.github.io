#version 460

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 32) in;

#define COLLISION_SET 1
#include "common.glsl"

layout(set = 2, binding = 0, scalar) buffer Values {
    float values[];
};

layout(set = 2, binding = 1, scalar) buffer ColIndices {
    uint colIndices[];
};

layout(set = 2, binding = 2, scalar) buffer RowOffsets {
    uint rowOffsets[];
};

layout(set = 2, binding = 3, scalar) buffer Counts {
    uint rowCount;
    uint colCount;
    uint nonZeroCount;
};

layout(push_constant, scalar) uniform Constants {
    uvec3 gridSize;
    vec3 alpha;
    float identity;
    uint batchOffset;
    uint batchSize;
    uint vectorFieldComponent;
};

uint entriesPerRow() {
    return is3D ? 7u : 5u;
}

uint rowOf(ivec3 cell) {
    return uint(cell.z) * gridSize.x * gridSize.y + uint(cell.y) * gridSize.x + uint(cell.x);
}

void writeEntry(uint base, uint slot, float value, uint col) {
    values[base + slot] = value;
    colIndices[base + slot] = col;
}

void writeNeighbor(uint base, uint slot, inout float centerValue, ivec3 cell, ivec3 sampleCell, float weight) {
    // Wrapping case only
    if (wrappingEnabled) {
        sampleCell = collisionSampleCoord(sampleCell);

        if (isInsideWall(sampleCell)) {
            writeEntry(base, slot, 0.0, rowOf(cell));
            return;
        }

        centerValue += weight;
        writeEntry(base, slot, -weight, rowOf(sampleCell));
        return;
    }

    // Non-wrapping: NEVER clamp matrix neighbours.
    if (outOfBounds(sampleCell)) {
        // OPEN boundary / outlet:
        // p_outside = 0, so this contributes weight * p_center.
        centerValue += weight;
        writeEntry(base, slot, 0.0, rowOf(cell));
        return;

        // CLOSED boundary version would be:
        // writeEntry(base, slot, 0.0, rowOf(cell));
        // return;
    }

    // Solid wall: Neumann pressure, no contribution.
    if (isInsideWall(sampleCell)) {
        writeEntry(base, slot, 0.0, rowOf(cell));
        return;
    }

    // Normal fluid neighbour.
    centerValue += weight;
    writeEntry(base, slot, -weight, rowOf(sampleCell));
}

void main() {
    uint localRow = gl_GlobalInvocationID.x;
    if (localRow >= batchSize) return;

    uint row = batchOffset + localRow;
    uint totalRows = gridSize.x * gridSize.y * gridSize.z;
    if (row >= totalRows) return;

    uint rowEntryCount = entriesPerRow();
    if (row == 0u) {
        rowCount = totalRows;
        colCount = totalRows;
        nonZeroCount = totalRows * rowEntryCount;
    }

    rowOffsets[row] = row * rowEntryCount;
    rowOffsets[row + 1u] = (row + 1u) * rowEntryCount;

    uint base = row * rowEntryCount;
    uint cellsPerSlice = gridSize.x * gridSize.y;
    ivec3 cell = ivec3(
        int(row % gridSize.x),
        int((row % cellsPerSlice) / gridSize.x),
        int(row / cellsPerSlice)
    );

    float ax = alpha.x;
    float ay = alpha.y;
    float az = alpha.z;

    float centerValue = 0;
    if (isInsideWall(cell)) {
        for(uint slot = 0u; slot + 1u < rowEntryCount; ++slot) {
            writeEntry(base, slot, 0.0, row);
        }
        writeEntry(base, rowEntryCount - 1u, 1.0, row);
        return;
    }

    writeNeighbor(base, 0u, centerValue, cell, cell + ivec3(-1, 0, 0), ax);
    writeNeighbor(base, 1u, centerValue, cell, cell + ivec3(1, 0, 0), ax);
    writeNeighbor(base, 2u, centerValue, cell, cell + ivec3(0, -1, 0), ay);
    writeNeighbor(base, 3u, centerValue, cell, cell + ivec3(0, 1, 0), ay);
    if(is3D) {
        writeNeighbor(base, 4u, centerValue, cell, cell + ivec3(0, 0, -1), az);
        writeNeighbor(base, 5u, centerValue, cell, cell + ivec3(0, 0, 1), az);
        writeEntry(base, 6u, identity + centerValue, row);
    } else {
        writeEntry(base, 4u, identity + centerValue, row);
    }
}
