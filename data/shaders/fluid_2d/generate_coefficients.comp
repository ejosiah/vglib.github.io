#version 460

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform sampler2D boundaryField;

layout(set = 1, binding = 0, scalar) buffer Values {
    float values[];
};

layout(set = 1, binding = 1, scalar) buffer ColIndices {
    uint colIndices[];
};

layout(set = 1, binding = 2, scalar) buffer RowOffsets {
    uint rowOffsets[];
};

layout(set = 1, binding = 3, scalar) buffer Counts {
    uint rowCount;
    uint colCount;
    uint nonZeroCount;
};

layout(push_constant, scalar) uniform Constants {
    uvec2 gridSize;
    vec2 alpha;
    float identity;
    uint batchOffset;
    uint batchSize;
    uint ensureBoundaryCondition;
    uint vectorFieldComponent;
};

const uint ENTRIES_PER_ROW = 5u;

uint rowOf(ivec2 cell) {
    return uint(cell.y) * gridSize.x + uint(cell.x);
}

bool outsideGrid(ivec2 cell) {
    return cell.x < 0 || cell.y < 0 || cell.x >= int(gridSize.x) || cell.y >= int(gridSize.y);
}

bool isObstacle(ivec2 cell) {
    if(ensureBoundaryCondition == 0u) return false;
    if(outsideGrid(cell)) return true;

    vec2 uv = (vec2(cell) + 0.5) / vec2(gridSize);
    ivec2 size = textureSize(boundaryField, 0);
    ivec2 coord = clamp(ivec2(floor(uv * vec2(size))), ivec2(0), size - ivec2(1));
    return texelFetch(boundaryField, coord, 0).r > 0.5;
}

ivec2 coefficientCell(ivec2 cell) {
    if(ensureBoundaryCondition != 0u) return cell;

    ivec2 size = ivec2(gridSize);
    return ivec2((cell.x + size.x) % size.x, (cell.y + size.y) % size.y);
}

vec2 boundaryNormal(ivec2 center, ivec2 sampleCell) {
    ivec2 offset = sampleCell - center;
    if(abs(offset.x) > abs(offset.y)) return vec2(sign(float(offset.x)), 0.0);
    if(abs(offset.y) > 0) return vec2(0.0, sign(float(offset.y)));
    return vec2(0.0);
}

float boundaryCenterAdjustment(float weight, ivec2 center, ivec2 sampleCell) {
    vec2 normal = boundaryNormal(center, sampleCell);
    bool reflectedComponent =
        (vectorFieldComponent == 1u && abs(normal.x) > 0.0) ||
        (vectorFieldComponent == 2u && abs(normal.y) > 0.0);
    return reflectedComponent ? weight : -weight;
}

void writeEntry(uint base, uint slot, float value, uint col) {
    values[base + slot] = value;
    colIndices[base + slot] = col;
}

void writeNeighbor(uint base, uint slot, inout float centerValue, ivec2 center, ivec2 sampleCell, float weight) {
    if(isObstacle(sampleCell)) {
        centerValue += boundaryCenterAdjustment(weight, center, sampleCell);
        writeEntry(base, slot, 0.0, rowOf(center));
        return;
    }

    writeEntry(base, slot, -weight, rowOf(coefficientCell(sampleCell)));
}

void main() {
    uint localRow = gl_GlobalInvocationID.x;
    if(localRow >= batchSize) return;

    uint row = batchOffset + localRow;
    uint totalRows = gridSize.x * gridSize.y;
    if(row >= totalRows) return;

    if(row == 0u) {
        rowCount = totalRows;
        colCount = totalRows;
        nonZeroCount = totalRows * ENTRIES_PER_ROW;
    }

    rowOffsets[row] = row * ENTRIES_PER_ROW;
    rowOffsets[row + 1u] = (row + 1u) * ENTRIES_PER_ROW;

    uint base = row * ENTRIES_PER_ROW;
    ivec2 cell = ivec2(int(row % gridSize.x), int(row / gridSize.x));

    if(isObstacle(cell)) {
        writeEntry(base, 0u, 1.0, row);
        writeEntry(base, 1u, 0.0, row);
        writeEntry(base, 2u, 0.0, row);
        writeEntry(base, 3u, 0.0, row);
        writeEntry(base, 4u, 0.0, row);
        return;
    }

    float ax = alpha.x;
    float ay = alpha.y;
    float centerValue = identity + 2.0 * (ax + ay);

    writeNeighbor(base, 1u, centerValue, cell, cell + ivec2(-1, 0), ax);
    writeNeighbor(base, 2u, centerValue, cell, cell + ivec2(1, 0), ax);
    writeNeighbor(base, 3u, centerValue, cell, cell + ivec2(0, -1), ay);
    writeNeighbor(base, 4u, centerValue, cell, cell + ivec2(0, 1), ay);
    writeEntry(base, 0u, centerValue, row);
}
