#version 460

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 32) in;

#define COLLISION_SET 1
#include "common.glsl"

layout(set = 2, binding = 0, scalar) buffer Values {
    float values[];
};

layout(set = 2, binding = 1, scalar) buffer ColIndices {
    uint colIndices[];
};

layout(set = 2, binding = 2, scalar) buffer RowOffsets {
    uint rowOffsets[];
};

layout(set = 2, binding = 3, scalar) buffer Counts {
    uint rowCount;
    uint colCount;
    uint nonZeroCount;
};

layout(push_constant, scalar) uniform Constants {
    uvec2 gridSize;
    vec2 alpha;
    float identity;
    uint batchOffset;
    uint batchSize;
    uint vectorFieldComponent;
};

const uint ENTRIES_PER_ROW = 5u;

uint rowOf(ivec2 cell) {
    return uint(cell.y) * gridSize.x + uint(cell.x);
}

void writeEntry(uint base, uint slot, float value, uint col) {
    values[base + slot] = value;
    colIndices[base + slot] = col;
}

void writeNeighbor(uint base, uint slot, inout float centerValue, ivec2 cell, ivec2 sampleCell, float weight) {
    // Wrapping case only
    if (wrappingEnabled) {
        sampleCell = collisionSampleCoord(sampleCell);

        if (isInsideWall(sampleCell)) {
            writeEntry(base, slot, 0.0, rowOf(cell));
            return;
        }

        centerValue += weight;
        writeEntry(base, slot, -weight, rowOf(sampleCell));
        return;
    }

    // Non-wrapping: NEVER clamp matrix neighbours.
    if (outOfBounds(sampleCell)) {
        // OPEN boundary / outlet:
        // p_outside = 0, so this contributes weight * p_center.
        centerValue += weight;
        writeEntry(base, slot, 0.0, rowOf(cell));
        return;

        // CLOSED boundary version would be:
        // writeEntry(base, slot, 0.0, rowOf(cell));
        // return;
    }

    // Solid wall: Neumann pressure, no contribution.
    if (isInsideWall(sampleCell)) {
        writeEntry(base, slot, 0.0, rowOf(cell));
        return;
    }

    // Normal fluid neighbour.
    centerValue += weight;
    writeEntry(base, slot, -weight, rowOf(sampleCell));
}

void main() {
    uint localRow = gl_GlobalInvocationID.x;
    if (localRow >= batchSize) return;

    uint row = batchOffset + localRow;
    uint totalRows = gridSize.x * gridSize.y;
    if (row >= totalRows) return;

    if (row == 0u) {
        rowCount = totalRows;
        colCount = totalRows;
        nonZeroCount = totalRows * ENTRIES_PER_ROW;
    }

    rowOffsets[row] = row * ENTRIES_PER_ROW;
    rowOffsets[row + 1u] = (row + 1u) * ENTRIES_PER_ROW;

    uint base = row * ENTRIES_PER_ROW;
    ivec2 cell = ivec2(int(row % gridSize.x), int(row / gridSize.x));

    float ax = alpha.x;
    float ay = alpha.y;

    float centerValue = 0;
    if (isInsideWall(cell)) {
        writeEntry(base, 0u, 0.0, row);
        writeEntry(base, 1u, 0.0, row);
        writeEntry(base, 2u, 0.0, row);
        writeEntry(base, 3u, 0.0, row);
        writeEntry(base, 4u, 1.0, row);
        return;
    }

    writeNeighbor(base, 0u, centerValue, cell, cell + ivec2(-1, 0), ax);
    writeNeighbor(base, 1u, centerValue, cell, cell + ivec2(1, 0), ax);
    writeNeighbor(base, 2u, centerValue, cell, cell + ivec2(0, -1), ay);
    writeNeighbor(base, 3u, centerValue, cell, cell + ivec2(0, 1), ay);
    writeEntry(base, 4u, identity + centerValue, row);
}
