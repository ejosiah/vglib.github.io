#version 460

#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 256) in;

#define COLLISION_SET 2
#include "common.glsl"

layout(set = 1, binding = 0) uniform sampler3D sourceField;

layout(set = 3, binding = 0, scalar) buffer MeanDrift {
    float mean;
    uint sampleCount;
};

layout(push_constant, scalar) uniform Constants {
    uint cellCount;
};

shared float localSum[256];
shared uint localCount[256];

bool hasActiveWall(ivec3 coord) {
    return isInsideWall(coord);
}

void main() {
    uint localId = gl_LocalInvocationID.x;
    float sum = 0.0;
    uint validCount = 0u;

    for(uint index = localId; index < cellCount; index += 256u) {
        uint cellsPerSlice = uint(grid_size.x * grid_size.y);
        ivec3 cell = ivec3(
            int(index % uint(grid_size.x)),
            int((index % cellsPerSlice) / uint(grid_size.x)),
            int(index / cellsPerSlice)
        );
        if(!hasActiveWall(cell)) {
            sum += texelFetch(sourceField, cell, 0).x;
            ++validCount;
        }
    }

    localSum[localId] = sum;
    localCount[localId] = validCount;
    barrier();

    for(uint stride = 128u; stride > 0u; stride >>= 1u) {
        if(localId < stride) {
            localSum[localId] += localSum[localId + stride];
            localCount[localId] += localCount[localId + stride];
        }
        barrier();
    }

    if(localId == 0u) {
        mean = localCount[0] == 0u ? 0.0 : localSum[0] / float(localCount[0]);
        sampleCount = localCount[0];
    }
}
